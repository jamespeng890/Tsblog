{
  "name": "blog-platform",
  "version": "1.0.0",
  "description": "A semi-static blog platform",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler pages dev public",
    "build": "esbuild src/index.ts --bundle --outfile=public/_worker.js --format=esm --platform=browser --external:cloudflare:workers --alias:buffer=node:buffer --alias:crypto=node:crypto --alias:stream=node:stream --alias:util=node:util --alias:events=node:events",
    "deploy": "wrangler pages deploy public",
    "db:init": "wrangler d1 execute blog-db --file schema.sql"
  },
  "dependencies": {
    "marked": "^11.1.1",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "wrangler": "^3.26.1",
    "@cloudflare/workers-types": "^4.20231218.0",
    "@types/node": "^20.10.5",
    "@types/jsonwebtoken": "^9.0.5",
    "esbuild": "^0.19.11"
  }
}
